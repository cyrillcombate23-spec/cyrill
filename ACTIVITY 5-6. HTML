    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            color: #222;
        }

        p {
            font-size: 18px;
            line-height: 1.5;
            text-align: justify;
        }

        h1,
        h2,
        h3 {
            font-family: Arial, sans-serif;
        }

        a:link {
            color: rgb(238, 12, 125);
        }

        a:visited {
            color: rgb(247, 231, 10);
        }

        a:hover {
            color: rgb(235, 17, 144);
        }

        .important {
            background-color: rgb(224, 42, 10);
            font-weight: bold;
            padding: 5px;
        }

        header {
            background: linear-gradient(to right, #4206e9, #f10b54);
            color: white;
            padding: 30px;
            text-align: center;
        }

        #mainHeading {
            color: white;
            text-align: center;
            font-size: 36px;
            text-transform: uppercase;
        }

        header p {
            text-align: center;
        }

        article {
            padding: 15px;
            margin: 15px;
            background-color: white;
            border-radius: 10px;
        }

        section {
            padding: 15px;
            border: 2px solid #0bf01e;
            margin: 15px;
            border-radius: 10px;
            background-color: white;
        }

        .gradient-box {
            background: linear-gradient(to right, #4206e9, #f10b54);
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
            color: white;
        }

        .color-box {
            background-color: #f80606b9;
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
        }

        .flex-nav {
            display: flex;
            justify-content: space-around;
            align-items: center;
            background-color: #4206e9;
            padding: 15px;
            margin: 15px;
            border-radius: 10px;
            flex-wrap: wrap;
        }

        .flex-nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            padding: 10px 20px;
        }

        .flex-nav a:hover {
            background-color: #f10b54;
            color: white;
            border-radius: 5px;
        }

        img {
            border: 3px solid #0b80ec;
            border-radius: 10px;
            padding: 5px;
            margin: 10px;
            max-width: 100%;
            height: auto;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        figure {
            text-align: center;
        }

        figcaption {
            font-weight: bold;
            color: #4206e9;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th,
        td {
            padding: 10px;
            border: 1px solid rgb(145, 9, 230);
            text-align: center;
        }

        th {
            background-color: #4206e9;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f2eaff;
        }

        tr:hover {
            background-color: #ffd6e5;
        }

        form {
            padding: 20px;
            border: 2px solid #107ce06b;
            margin: 20px;
            border-radius: 10px;
            background-color: #f53780;
        }

        input,
        textarea,
        select {
            padding: 10px;
            margin: 5px;
            border-radius: 5px;
            border: 1px solid #777;
            width: 100%;
            max-width: 300px;
        }

        input[type="submit"] {
            background-color: #4206e9;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            max-width: 150px;
            transition: background-color 0.3s ease;
        }

        input[type="submit"]:hover {
            background-color: #f10b54;
        }

        .activity-nav {
            display: flex;
            justify-content: space-around;
            align-items: center;
            background-color: #4206e9;
            padding: 15px;
            border-radius: 10px;
            flex-wrap: wrap;
        }

        .activity-nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            padding: 10px 20px;
        }

        .activity-nav a:hover {
            background-color: #f10b54;
            border-radius: 5px;
        }

        .card-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            min-height: 300px;
            background-color: #e9e9ff;
            padding: 20px;
            border-radius: 10px;
        }

        .card {
            width: 250px;
            padding: 20px;
            background-color: white;
            border: 2px solid #4206e9;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .card h3 {
            color: #4206e9;
        }

        .card p {
            text-align: center;
        }

        .image-gallery {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 15px;
            padding: 20px;
        }

        .image-gallery img {
            width: 200px;
            height: 150px;
            object-fit: cover;
            margin: 0;
            border: 3px solid #0b80ec;
            border-radius: 10px;
            padding: 5px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .center-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 300px;
            background: linear-gradient(to right, #4206e9, #f10b54);
            border-radius: 10px;
        }

        .center-element {
            background-color: white;
            color: #4206e9;
            padding: 30px;
            border-radius: 10px;
            font-size: 24px;
            font-weight: bold;
            text-align: center;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            padding: 20px;
        }

        .blog-main {
            background-color: #e8f0ff;
            padding: 20px;
            border-radius: 10px;
            border: 2px solid #4206e9;
        }

        .blog-sidebar {
            background-color: #ffe8f0;
            padding: 20px;
            border-radius: 10px;
            border: 2px solid #f10b54;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            padding: 20px;
        }

        .product {
            background-color: white;
            border: 2px solid #0b80ec;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }

        .product h3 {
            color: #4206e9;
        }

        .product p {
            text-align: center;
        }

        .product button {
            background-color: #f10b54;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .product button:hover {
            background-color: #4206e9;
        }

        .calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
            padding: 20px;
            background-color: #eeeeff;
            border-radius: 10px;
        }

        .day-name {
            background-color: #4206e9;
            color: white;
            padding: 15px;
            text-align: center;
            font-weight: bold;
        }

        .day {
            background-color: white;
            border: 1px solid #999;
            min-height: 70px;
            padding: 10px;
            text-align: center;
        }

        .day:hover {
            background-color: #ffd6e5;
        }

        .span-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(3, 100px);
            gap: 10px;
            padding: 20px;
            background-color: #eeeeee;
        }

        .span-item {
            grid-column: 2 / 4;
            grid-row: 1 / 3;
            background: linear-gradient(to right, #4206e9, #f10b54);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 10px;
            font-size: 22px;
            font-weight: bold;
            text-align: center;
        }

        .small-item {
            background-color: #0bf01e;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 10px;
            font-weight: bold;
        }

        /* ================================================ */
        /* ACTIVITY 5: RESPONSIVE DESIGN */
        /* ================================================ */

        /* MOBILE-FIRST APPROACH: Default is single column */
        /* Activity 5 #1 - Media query for mobile devices */
        @media (max-width: 768px) {
            body {
                background-color: #f0f8ff;
            }
        }

        @media (max-width: 480px) {
            body {
                background-color: #fff0f5;
            }
        }

        /* Activity 5 #2 - Adjust font sizes for different screen widths */
        @media (max-width: 600px) {
            #mainHeading {
                font-size: 28px;
            }

            h2 {
                font-size: 24px;
            }

            h3 {
                font-size: 20px;
            }

            p {
                font-size: 16px;
                line-height: 1.6;
            }
        }

        @media (max-width: 400px) {
            #mainHeading {
                font-size: 22px;
            }

            h2 {
                font-size: 20px;
            }

            h3 {
                font-size: 18px;
            }

            p {
                font-size: 14px;
                line-height: 1.6;
            }
        }

        /* Activity 5 #4 - Hide sidebar on screens smaller than 600px */
        @media (max-width: 600px) {
            .blog-sidebar {
                display: none;
            }

            .blog-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Activity 5 #5 - Mobile-first: single column to multiple columns on larger screens */
        /* Already implemented with existing media queries, but enhancing */

        /* Small screens (mobile) - single column (default) */
        @media (max-width: 599px) {
            .card-container {
                flex-direction: column;
            }

            .flex-nav {
                flex-direction: column;
                gap: 5px;
            }

            .activity-nav {
                flex-direction: column;
                gap: 5px;
            }

            .product-grid {
                grid-template-columns: 1fr;
            }

            .image-gallery img {
                width: 100%;
                height: auto;
            }

            .calendar {
                padding: 5px;
                gap: 2px;
            }

            .day-name {
                padding: 8px 2px;
                font-size: 11px;
            }

            .day {
                min-height: 50px;
                padding: 5px;
                font-size: 12px;
            }

            .span-grid {
                grid-template-columns: repeat(2, 1fr);
                grid-template-rows: repeat(4, 80px);
            }

            .span-item {
                grid-column: 1 / 3;
                grid-row: 2 / 4;
            }

            /* Adjust form inputs for mobile */
            input,
            textarea,
            select {
                max-width: 100%;
                width: 100%;
            }
        }

        /* Medium screens (tablet) - 2 columns */
        @media (min-width: 600px) and (max-width: 899px) {
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .blog-grid {
                grid-template-columns: 1fr;
            }

            .card-container {
                flex-wrap: wrap;
            }
        }

        /* Large screens (desktop) - 3+ columns (already default) */
        @media (min-width: 900px) {
            .product-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        /* ================================================ */
        /* ACTIVITY 6: STYLED BLOG PAGE WITH FEEDBACK FORM */
        /* ================================================ */

        /* Activity 6 #1 - Style the blog content */
        /* - Readable fonts and paragraph font size 18px (already set) */
        /* - Spacing between sections (already using margins/padding) */
        /* - Style headings with distinctive colors and font weights */
        h1 {
            color: #4206e9;
            font-weight: 700;
        }

        h2 {
            color: #f10b54;
            font-weight: 600;
        }

        h3 {
            color: #4206e9;
            font-weight: 500;
        }

        /* Activity 6 #2 - Style the form */
        /* - Consistent padding and border to all input fields (already set) */
        /* - Different background colors for the form section (already set) */
        /* - Style submit button with hover effects (already set with transition) */
        #feedback {
            background-color: #f5f0ff;
            border: 2px solid #4206e9;
        }

        form {
            background: linear-gradient(to bottom, #f53780, #ff8aae);
            border: 2px solid #4206e9;
        }

        form label {
            font-weight: bold;
            color: white;
        }

        input[type="checkbox"]+label,
        input[type="radio"]+label {
            color: white;
        }

        /* Activity 6 #3 - Style the images */
        /* - Borders or shadows to enhance visual appeal (already set) */
        /* - max-width: 100% so they scale properly (already set) */

        /* Activity 6 #4 - Box model for consistent spacing across all elements */
        /* Already implemented with * { box-sizing: border-box; } */
        /* Additional box model improvements */
        section,
        article,
        div,
        header,
        footer,
        nav {
            box-sizing: border-box;
        }

        /* Additional form styling for Activity 6 */
        .form-group {
            margin-bottom: 15px;
        }

        /* Style the skill checkboxes and radio buttons container */
        .form-group label {
            display: inline-block;
            margin-right: 10px;
        }

        .form-group input[type="checkbox"],
        .form-group input[type="radio"] {
            width: auto;
            margin-right: 5px;
        }

        /* Special styling for the file input */
        input[type="file"] {
            padding: 8px;
            background-color: white;
            border: 2px solid #4206e9;
        }

        /* Add focus styles for accessibility */
        input:focus,
        textarea:focus,
        select:focus {
            outline: 2px solid #4206e9;
            border-color: #f10b54;
        }

    </style>

</head>


